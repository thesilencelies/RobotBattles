{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Regenerate All Data",
            "type": "shell",
            "command": "python3",
            "args": [
                "${workspaceFolder}/scripts/regenerate_all_data.py"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": []
        },
        {
            "label": "Regenerate All Data (Quick)",
            "type": "shell",
            "command": "python3",
            "args": [
                "${workspaceFolder}/scripts/regenerate_all_data.py",
                "--quick"
            ],
            "group": "build",
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": []
        },
        {
            "label": "Build Rules PDF",
            "command": "pdflatex",
            "type": "shell",
            "args": [
                "-interaction=nonstopmode",
                "combat_robotics_game.tex"
            ],
            "options": {
                "cwd": "${workspaceFolder}/rules"
            },
            "group": "build",
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": []
        },
        {
            "label": "Upload Rules",
            "command": "python3",
            "type": "shell",
            "args": [
                "upload_rules.py"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": "build",
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": []
        },
        {
            "label": "Build and Upload Rules",
            "type": "shell",
            "command": "echo 'Rules successfully built and uploaded.'",
            "dependsOrder": "sequence",
            "dependsOn": [
                "Build Rules PDF",
                "Upload Rules"
            ],
            "group": "build",
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": []
        }
    ]
}
