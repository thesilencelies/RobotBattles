{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Regenerate All Data",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/scripts/regenerate_all_data.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "Regenerate All Data (Quick)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/scripts/regenerate_all_data.py",
            "args": [
                "--quick"
            ],
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "Interactive Robot Builder",
            "type": "debugpy",
            "request": "launch",
            "module": "builder.server",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "Playtest Server",
            "type": "debugpy",
            "request": "launch",
            "module": "playtest.server",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "Regenerate and Upload Rules",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/upload_rules.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "preLaunchTask": "Build Rules PDF"
        },
        {
            "name": "Regenerate and Upload Rules (Force)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/upload_rules.py",
            "args": [
                "--force"
            ],
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "preLaunchTask": "Build Rules PDF"
        }
    ]
}
